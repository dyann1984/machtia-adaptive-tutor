# ===================================================
# MACHTIA Adaptive Tutor - Environment Configuration
# ===================================================

# Execution Mode: "mock" (default demo mode) | "amazon" | "nebius"
AI_PROVIDER=mock

# MCP Server Configuration
MCP_PORT=3100
NEXT_PUBLIC_MCP_URL=http://localhost:3100/mcp

# Amazon Bedrock / Alexa+ Configuration (Optional - for Amazon Mode)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_aws_session_token_if_temporary
# AWS_BEDROCK_API_KEY=your_bedrock_api_key_if_using_api_key
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Nebius AI Studio / NVIDIA NIM Configuration (Optional - for Nebius Mode)
# NEBIUS_API_KEY=your_nebius_api_key_here
