# Synthetic demo only. External Bedrock/Alexa+/Nebius providers are not implemented.
JUDGE_DEMO=true
NEXT_PUBLIC_JUDGE_DEMO=true
AI_PROVIDER=mock

# dev:all overrides the web URL to the standalone MCP development service.
NEXT_PUBLIC_MCP_URL=/mcp
MCP_PORT=3100
MCP_HOST=127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render supplies RENDER_GIT_COMMIT for /health provenance.
# Do not enter real student data or Amazon credentials into this demo.
