# Synthetic demo only. External Bedrock/Alexa+/Nebius providers are not implemented.
JUDGE_DEMO=true
NEXT_PUBLIC_JUDGE_DEMO=true
AI_PROVIDER=mock

# dev:all overrides the web URL to the standalone MCP development service.
NEXT_PUBLIC_MCP_URL=/mcp
MCP_PORT=3100
MCP_HOST=127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render supplies RENDER_GIT_COMMIT for /health provenance.
# Do not enter real student data or Amazon credentials into this demo.

# ==============================================================================
# MIA Adaptive Companion - ElevenLabs Text-to-Speech (Server-side Only)
# Protected secrets: NEVER use NEXT_PUBLIC_ prefix for these variables.
# If ELEVENLABS_API_KEY or ELEVENLABS_VOICE_ID is omitted, MIA automatically
# uses the high-fidelity Mexican Spanish Web Speech API fallback.
# ==============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Female Mexican Spanish or Multilingual Voice ID (e.g. Paulina, Sofia, or your custom cloned voice)
ELEVENLABS_VOICE_ID=your_selected_voice_id_here
# Model ID: eleven_multilingual_v2 (recommended for natural educational Mexican Spanish) or eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Server-side secret for HMAC Didactic Signatures (prevents arbitrary/unauthorized text synthesis)
MIA_HMAC_SECRET=your_strong_random_hmac_secret_here

# Restricts ElevenLabs synthesis strictly to authenticated judge/demo sessions (Contest Safe Mode)
ELEVENLABS_PUBLIC_TRAFFIC_ENABLED=false

