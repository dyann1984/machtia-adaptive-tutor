{
  "name": "machtia-adaptive-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "MACHTIA educational demo with real MCP and a simulated Alexa+ experience",
  "scripts": {
    "mcp:start": "tsx mcp/server/index.ts",
    "mcp": "tsx mcp/server/index.ts",
    "dev": "node scripts/run-next.mjs dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node scripts/run-next.mjs build",
    "start": "tsx scripts/serve-production.ts",
    "start:render": "tsx scripts/serve-production.ts",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern .repair-backup-20261005",
    "test": "vitest run",
    "test:e2e": "tsx scripts/verify-shared-evidence.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.27",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.0",
    "esbuild": "npm:esbuild-wasm@0.28.2",
    "postcss": "8.5.29"
  }
